@model RegisterDto
@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
}

    <main class="w-full h-screen">
        <div class="flex flex-col w-full h-full relative overflow-hidden bg-surface opacity-0 animate-[fadeIn_0.6s_ease-out_forwards]">
            <div class="flex flex-col md:flex-row h-full w-full">
                <!-- Left side: Visual Branding -->
                <div class="hidden md:flex md:w-1/2 h-full relative items-center justify-center p-xl lg:p-xxl">
                    <!-- Background Image -->
                    <div class="absolute inset-0 z-0">
                        <div class="w-full h-full bg-cover bg-center" style="background-image: url('/images/auth/login-bg.jpg')"></div>
                        <div class="absolute inset-0 bg-surface/40 backdrop-blur-[2px]"></div>
                        <div class="absolute inset-0 bg-gradient-to-r from-surface-dim/80 to-surface/90"></div>
                    </div>
                </div>
                <!-- Right side: Registration Form -->
                <div class="w-full md:w-1/2 h-full flex flex-col items-center justify-center p-md sm:p-lg lg:p-xl relative z-10 overflow-y-auto">
                    <div class="w-full max-w-md flex flex-col bg-surface-container rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] p-lg sm:p-xl relative overflow-hidden group opacity-0 animate-[slideUp_0.6s_ease-out_0.3s_forwards] backdrop-blur-[12px] border border-white/5">
                        <!-- Top decorative gradient line -->
                        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-primary/50 to-transparent opacity-50 group-hover:opacity-100 transition-opacity duration-500"></div>
                        <div class="mb-10 text-center">
                            <h2 class="text-headline-lg text-on-surface font-headline-lg mb-2">Hesap Oluştur</h2>
                            <p class="text-body-md text-on-surface-variant font-body-md">Alttaki formu doldurarak hemen hesabını oluşturabilirsin!</p>
                        </div>
                        <form method="post" class="flex flex-col gap-6">
                            <div class="mb-4 text-center">
                                @Html.ValidationSummary(false, "", new { @class = "text-red-400 text-sm" })
                            </div>
                            <div class="flex gap-4">
                                <!-- First Name Field -->
                                <div class="flex flex-col gap-1 w-1/2 relative">
                                    <label class="text-label-sm text-on-surface font-label-sm uppercase tracking-wider ml-1" for="firstName">Ad</label>
                                    <div class="relative group/input">
                                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px] z-10 pointer-events-none">person</span>
                                        <input class="w-full h-10 bg-surface-container-high text-on-surface text-body-md rounded-lg pl-10 pr-4 outline-none border border-white/10 focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all duration-200 placeholder-on-surface-variant/50" asp-for="FirstName" placeholder="Hasan" required="" type="text" />
                                        <span asp-validation-for="FirstName" class="text-red-400 text-xs"></span>
                                    </div>
                                </div>
                                <!-- Last Name Field -->
                                <div class="flex flex-col gap-1 w-1/2 relative">
                                    <label class="text-label-sm text-on-surface font-label-sm uppercase tracking-wider ml-1" for="lastName">Soyad</label>
                                    <div class="relative group/input">
                                        <input class="w-full h-10 bg-surface-container-high text-on-surface text-body-md rounded-lg px-4 outline-none border border-white/10 focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all duration-200 placeholder-on-surface-variant/50" asp-for="LastName" placeholder="Berk" required="" type="text" />
                                        <span asp-validation-for="LastName" class="text-red-400 text-xs"></span>
                                    </div>
                                </div>
                            </div>
                            <!-- Username Field -->
                            <div class="flex flex-col gap-1 relative">
                                <label class="text-label-sm text-on-surface font-label-sm uppercase tracking-wider ml-1" for="username">Kullanıcı Adı</label>
                                <div class="relative group/input">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px] z-10 pointer-events-none">alternate_email</span>
                                    <input class="w-full h-10 bg-surface-container-high text-on-surface text-body-md rounded-lg pl-10 pr-4 outline-none border border-white/10 focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all duration-200 placeholder-on-surface-variant/50" asp-for="UserName" placeholder="HBT" required="" type="text" />
                                    <span asp-validation-for="UserName" class="text-red-400 text-xs"></span>
                                </div>
                            </div>
                            <!-- Email Field -->
                            <div class="flex flex-col gap-1 relative">
                                <label class="text-label-sm text-on-surface font-label-sm uppercase tracking-wider ml-1" for="email">Email Adresi</label>
                                <div class="relative group/input">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px] z-10 pointer-events-none">mail</span>
                                    <input class="w-full h-10 bg-surface-container-high text-on-surface text-body-md rounded-lg pl-10 pr-4 outline-none border border-white/10 focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all duration-200 placeholder-on-surface-variant/50" asp-for="Email" placeholder="hbt@example.com" required="" type="email" />
                                    <span asp-validation-for="Email" class="text-red-400 text-xs"></span>
                                </div>
                            </div>
                            <!-- Password Field -->
                            <div class="flex flex-col gap-1 relative">
                                <label class="text-label-sm text-on-surface font-label-sm uppercase tracking-wider ml-1" for="password">Şifre</label>
                                <div class="relative group/input">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px] z-10 pointer-events-none">lock</span>
                                    <input id="password" class="w-full h-10 bg-surface-container-high text-on-surface text-body-md rounded-lg pl-10 pr-10 outline-none border border-white/10 focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all duration-200 placeholder-on-surface-variant/50" asp-for="Password" placeholder="••••••••" required="" type="password" />
                                    <span asp-validation-for="Password" class="text-red-400 text-xs"></span>
                                    <button class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition-colors focus:outline-none" onclick="togglePassword('password', 'toggleIcon1')" type="button">
                                        <span class="material-symbols-outlined text-[18px]" id="toggleIcon1">visibility</span>
                                    </button>
                                </div>
                            </div>
                            <!-- Confirm Password Field -->
                            <div class="flex flex-col gap-1 relative">
                                <label class="text-label-sm text-on-surface font-label-sm uppercase tracking-wider ml-1" for="confirmPassword">Şifre Tekrar</label>
                                <div class="relative group/input">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px] z-10 pointer-events-none">lock_reset</span>
                                    <input id="confirmPassword" class="w-full h-10 bg-surface-container-high text-on-surface text-body-md rounded-lg pl-10 pr-10 outline-none border border-white/10 focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all duration-200 placeholder-on-surface-variant/50" asp-for="ConfirmPassword" placeholder="••••••••" required="" type="password" />
                                    <span asp-validation-for="ConfirmPassword" class="text-red-400 text-xs"></span>
                                    <button class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition-colors focus:outline-none" onclick="togglePassword('confirmPassword', 'toggleIcon2')" type="button">
                                        <span class="material-symbols-outlined text-[18px]" id="toggleIcon2">visibility</span>
                                    </button>
                                </div>
                            </div>
                            <!-- Actions -->
                            <div class="flex flex-col gap-4 mt-4">
                                <button class="w-full h-10 bg-[#3B82F6] hover:brightness-110 text-white font-label-sm rounded-lg transition-all duration-200 flex items-center justify-center gap-2 shadow-lg shadow-primary/20" type="submit">
                                    Kayıt Ol
                                    <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                                </button>
                                <a asp-controller="Auth"
                                   asp-action="Login"
                                   class="w-full h-10 bg-transparent border border-white/20 hover:bg-white/5 text-on-surface font-label-sm rounded-lg transition-all duration-200 flex items-center justify-center gap-2">
                                    Girişe Dön
                                </a>
                            </div>
                        </form>
                        <p class="mt-8 text-center text-body-sm text-on-surface-variant">
                            Zaten hesabın var mı?
                            <a asp-controller="Auth"
                               asp-action="Login"
                               class="text-primary hover:text-primary-container font-medium">
                                Giriş Yap
                            </a>
                        </p>
                    </div>
                </div>
            </div>
            <style>
                @@keyframes fadeIn {
                    from

                {
                    opacity: 0;
                }

                to {
                    opacity: 1;
                }

                }
                @@keyframes slideUp {
                    from

                {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }

                }
            </style>
            <script>
                function togglePassword(inputId, iconId) {
                  const input = document.getElementById(inputId);
                  const icon = document.getElementById(iconId);

                  if (input.type === 'password') {
                    input.type = 'text';
                    icon.textContent = 'visibility_off';
                  } else {
                    input.type = 'password';
                    icon.textContent = 'visibility';
                  }
                }
            </script>
        </div>
    </main>