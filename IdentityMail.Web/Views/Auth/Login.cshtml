@model LoginDto
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

    <main class="w-full h-screen">
        <div asp-validation-summary="ModelOnly"
             class="mb-4 rounded-lg bg-red-500/10 border border-red-500/30 p-3 text-red-300 text-center">
        </div>
        <div class="flex flex-col w-full h-full min-h-[calc(100vh-64px)] animate-[fadeIn_0.5s_ease-out]">
            <div class="flex flex-col lg:flex-row w-full h-full flex-grow">
                <!-- Left Side: Marketing / Brand -->
                <div class="relative hidden lg:flex flex-col justify-end w-1/2 p-xl xxl:p-xxl bg-cover bg-center overflow-hidden" style="background-image: url('/images/auth/login-bg.jpg');">
                </div>
                <!-- Right Side: Login -->
                <div class="flex flex-col justify-center items-center w-full lg:w-1/2 p-lg lg:p-xl bg-background relative overflow-hidden">
                    <!-- Subtle ambient glow background -->
                    <div class="absolute top-1/4 -right-1/4 w-96 h-96 bg-primary/10 rounded-full blur-[100px] pointer-events-none"></div>
                    <div class="absolute bottom-1/4 -left-1/4 w-96 h-96 bg-secondary-container/20 rounded-full blur-[100px] pointer-events-none"></div>
                    <div class="w-full max-w-md relative z-10">
                        <!-- Login Card -->
                        <div class="bg-surface-container/90 backdrop-blur-xl rounded-2xl p-xl shadow-2xl relative">
                            <!-- Glass edge simulation -->
                            <div class="absolute inset-0 rounded-2xl ring-1 ring-white/10 pointer-events-none"></div>
                            <div class="mb-lg">
                                <h2 class="font-headline-lg text-headline-lg text-on-background mb-xs">Hoşgeldiniz</h2>
                                <p class="font-body-md text-body-md text-on-surface-variant">Güvenli bir şekilde giriş yapabilirsiniz.</p>
                            </div>
                            <form class="space-y-lg" id="loginForm" method="post">
                                <!-- Email Input -->
                                <div class="space-y-sm">
                                    <label class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider block" for="email">Email Adresi</label>
                                    <div class="relative group">
                                        <span class="absolute left-md top-1/2 -translate-y-1/2 material-symbols-outlined text-outline transition-colors group-focus-within:text-primary pointer-events-none">mail</span>
                                        <input class="w-full h-12 bg-surface pl-12 pr-md rounded-lg text-on-background font-body-md text-body-md ring-1 ring-white/10 focus:ring-primary focus:ring-2 focus:outline-none transition-all duration-300 placeholder:text-outline/50 shadow-inner group-hover:ring-white/20"  placeholder="test@mail.com" required="" type="email" asp-for="Email" />
                                        <span asp-validation-for="Email" class="text-red-400 text-sm"></span>
                                    </div>
                                </div>
                                <!-- Password Input -->
                                <div class="space-y-sm">
                                    <label class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider block" for="password">Şifre</label>
                                    <div class="relative group">
                                        <span class="absolute left-md top-1/2 -translate-y-1/2 material-symbols-outlined text-outline transition-colors group-focus-within:text-primary pointer-events-none">lock</span>
                                        <input class="w-full h-12 bg-surface pl-12 pr-md rounded-lg text-on-background font-body-md text-body-md ring-1 ring-white/10 focus:ring-primary focus:ring-2 focus:outline-none transition-all duration-300 placeholder:text-outline/50 shadow-inner group-hover:ring-white/20"  placeholder="••••••••" required="" type="password" asp-for="Password" />
                                        <span asp-validation-for="Password" class="text-red-400 text-sm"></span>
                                    </div>
                                </div>
                                <!-- Options Row -->
                                <div class="flex items-center justify-between mt-sm">
                                    <label class="flex items-center gap-sm cursor-pointer group">
                                        <div class="relative flex items-center justify-center w-4 h-4">
                                            <input asp-for="RememberMe"
                                                   class="peer appearance-none w-4 h-4 rounded bg-surface ring-1 ring-white/20 checked:bg-primary checked:ring-primary transition-all cursor-pointer"
                                                   type="checkbox" />
                                            <span class="material-symbols-outlined absolute text-[12px] text-on-primary opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity" style="font-variation-settings: 'FILL' 1;">check</span>
                                        </div>
                                        <span class="font-body-md text-body-md text-on-surface-variant group-hover:text-on-background transition-colors">Beni Hatırla</span>
                                    </label>
                                    <a class="font-label-sm text-label-sm text-primary hover:text-primary-fixed transition-colors" href="#">Şifremi Unuttum</a>
                                </div>
                                <!-- Login Button -->
                                <button class="w-full h-12 bg-primary text-on-primary font-label-sm text-label-sm uppercase tracking-wider rounded-lg hover:bg-primary-fixed hover:shadow-[0_0_20px_rgba(59,130,246,0.3)] transition-all duration-300 transform active:scale-[0.98] mt-xl" type="submit">
                                    Giriş Yap
                                </button>
                            </form>
                            <!-- Divider -->
                            <div class="relative my-xl">
                                <div aria-hidden="true" class="absolute inset-0 flex items-center">
                                    <div class="w-full border-t border-white/10"></div>
                                </div>
                                <div class="relative flex justify-center text-sm">
                                    <span class="px-md bg-surface-container/90 text-on-surface-variant font-label-sm text-label-sm">---</span>
                                </div>
                            </div>
                            <!-- Register Section -->
                            <div class="text-center flex flex-col items-center gap-md">
                                <p class="font-body-md text-body-md text-on-surface-variant">Henüz hesabınız yok mu?</p>
                                <a asp-controller="Auth" asp-action="Register" class="w-full h-10 flex items-center justify-center bg-transparent text-on-background font-label-sm text-label-sm uppercase tracking-wider rounded-lg ring-1 ring-outline-variant hover:bg-white/5 transition-all duration-300">
                                    Kayıt Ol
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <style>
            @@keyframes fadeIn {
              from { opacity: 0; transform: translateY(10px); }
              to { opacity: 1; transform: translateY(0); }
            }
        </style>
    </main>