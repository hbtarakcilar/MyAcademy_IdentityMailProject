@model List<UserMessage>
@{
    ViewData["Title"] = "Gelen Kutusu";
    Layout = "_MainLayout";
}


<div class="px-xl py-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-lg border-b border-outline-variant/30">
    <div>
        <h1 class="font-display-lg text-display-lg text-on-surface mb-xs">Gelen Kutusu</h1>
        <p class="font-body-md text-body-md text-on-surface-variant">You have 3 unread messages.</p>
    </div>
    <div class="flex items-center gap-sm">
        <button class="px-md py-sm rounded-full bg-primary-container text-on-primary-container font-label-sm text-label-sm tracking-wide transition-all shadow-sm">Hepsi</button>
        <button class="px-md py-sm rounded-full bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm tracking-wide hover:bg-surface-variant transition-all">Okunmamış</button>
        <button class="px-md py-sm rounded-full bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm tracking-wide hover:bg-surface-variant transition-all flex items-center gap-xs">
            <span class="material-symbols-outlined text-[16px]">star</span>
            Önemli
        </button>
    </div>
</div>
<div class="px-md py-md space-y-xs">
    @foreach (var item in Model)
    {
        <a asp-controller="Message" asp-action="MailDetail" asp-route-id="@item.Id" class="group relative flex items-center p-md rounded-xl bg-surface-variant shadow-sm transition-all cursor-pointer border-l-4 border-primary">
            @if (!item.IsRead)
            {
                <div class="absolute left-sm top-1/2 -translate-y-1/2 w-2 h-2 rounded-full bg-primary"></div>
            }
            <div class="ml-lg mr-md w-10 h-10 rounded-full overflow-hidden bg-surface-container-high flex items-center justify-center shrink-0 shadow-sm">
                @if (!string.IsNullOrWhiteSpace(item.Sender.ProfileImageUrl))
                {
                    <img src="@item.Sender.ProfileImageUrl"
                         class="w-full h-full object-cover rounded-full" />
                }
                else
                {
                    <span class="material-symbols-outlined text-on-surface-variant">
                        person
                    </span>
                }
            </div>
            <div class="flex-1 min-w-0 mr-md">
                <div class="flex justify-between items-baseline mb-1">
                    <span class="font-headline-md text-[16px] leading-[24px] text-on-surface truncate">@item.Sender.FirstName @item.Sender.LastName</span>
                    <span class="font-label-sm text-label-sm text-primary shrink-0 ml-sm">@item.SendDate.ToString("dd MMM HH:mm")</span>
                </div>
                <div class="font-body-md text-body-md text-on-surface truncate font-semibold">@item.Subject</div>
                <div class="font-body-md text-body-md text-on-surface-variant truncate opacity-80">@(item.Body.Length > 80 ? item.Body[..80] + "..." : item.Body)</div>
            </div>
            <div class="flex items-center gap-sm shrink-0">
                <button class="p-sm rounded-full text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors">
                    <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">star</span>
                </button>
                <div class="w-8 flex justify-end group-hover:opacity-100 opacity-0 transition-opacity">
                    <button class="p-sm rounded-full text-on-surface-variant hover:bg-surface-container-high hover:text-error transition-colors">
                        <span class="material-symbols-outlined text-[20px]">delete</span>
                    </button>
                </div>
            </div>
        </a>
    }
</div>




