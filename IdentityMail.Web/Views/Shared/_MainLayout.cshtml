    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
</head>
<body class="bg-surface font-body-md text-on-surface">
    <!-- Sidebar -->
    @await Component.InvokeAsync("_DefaultSidebar")
    <div class="pl-72">
        <!-- Header -->
        @await Component.InvokeAsync("_DefaultHeader")
        <!-- Main Content Area --><main class="pt-20 min-h-screen bg-background">
            @RenderBody()
        </main>
    </div>
</body>
</html>